# ═══════════════════════════════════════════════════════════
# RAKSHAK — Environment Configuration
# Copy this file to .env and fill in your values
# DRDO Cybersecurity Division | v3.0.0
# ═══════════════════════════════════════════════════════════

# ── REQUIRED: Anthropic Claude API (GenAI reasoning engine) ─────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Alternative GenAI provider: Google Gemini.
# Set GEMINI_API_KEY locally in .env. GOOGLE_API_KEY is also accepted.
# Do not commit real API keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=

# ── OPTIONAL: Threat Intelligence APIs ──────────────────────────────────────

# VirusTotal — hash + domain + IP lookups (free tier: 500 req/day)
# Get from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB — IP reputation scoring (free tier: 1000 req/day)
# Get from: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Shodan — C2 infrastructure fingerprinting
# Get from: https://account.shodan.io/
SHODAN_API_KEY=

# ── SERVER CONFIGURATION ─────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── ANALYSIS LIMITS ──────────────────────────────────────────────────────────
MAX_APK_SIZE_MB=200
ANALYSIS_TIMEOUT_SEC=300
MAX_CONCURRENT_JOBS=5
